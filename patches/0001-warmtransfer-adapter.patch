+"""Probiert Nummernformate fuer den ausgehenden INVITE durch, bis eines klingelt."""
+import asyncio
+import os
+
+from app.sip_async.trunk import TrunkClient, TrunkConfig, build_sdp
+
+CFG = TrunkConfig(
+    domain=os.getenv("TRUNK_DOMAIN", "g.vsip.eu"),
+    user=os.getenv("TRUNK_USER", ""),
+    password=os.getenv("TRUNK_PASS", ""),
+    local_ip=os.getenv("TRUNK_LOCAL_IP", "212.87.214.9"),
+    local_port=int(os.getenv("TRUNK_LOCAL_PORT", "5065")),
+    caller_id=os.getenv("TRUNK_CLI", ""),
+)
+
+TARGETS = [
+    "+4915236448398",
+    "015236448398",
+    "004915236448398",
+    "4915236448398",
+    "15236448398",
+]
+
+
+async def main() -> None:
+    t = TrunkClient(CFG)
+    await t.open()
+    if not await t.register():
+        print("REGISTER fehlgeschlagen")
+        return
+    sdp = build_sdp(CFG.local_ip, 40202)
+    for target in TARGETS:
+        res = await t.invite(target, sdp, timeout=12.0)
+        print(f"{target:18s} -> status={res.get('status')} {res.get('reason', 'OK')}")
+        if res.get("ok"):
+            await t.bye(res)
+            print("   -> 200 OK, BYE gesendet")
+            break
+        if res.get("status") in (180, 183):
+            print("   -> klingelt")
+            break
+    t.close()
+
+
+asyncio.run(main())
