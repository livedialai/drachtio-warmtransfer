+def _dial_format(nummer: str) -> str:
+    """Normalisiert eine Rufnummer auf das Waehlformat des Trunks.
+
+    TRANSFER_DIAL_FORMAT: e164 (+49…), 0049 (0049…), 49 (49… — sipload).
+    """
+    fmt = (os.getenv("TRANSFER_DIAL_FORMAT") or "e164").lower()
+    dial = str(nummer).strip().replace(" ", "").replace("-", "").replace("/", "")
+    if dial.startswith("+"):
+        base = dial
+    elif dial.startswith("00"):
+        base = "+" + dial[2:]
+    elif dial.startswith("0"):
+        base = "+49" + dial[1:]
+    elif dial.startswith("49"):
+        base = "+" + dial
+    else:
+        base = "+49" + dial
+    if fmt == "e164":
+        return base
+    if fmt == "0049":
+        return "00" + base.lstrip("+")
+    return base.lstrip("+")
