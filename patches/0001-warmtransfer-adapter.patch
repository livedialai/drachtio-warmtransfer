+++ b/scripts/registrar.py
@@ -0,0 +1,47 @@
+"""Haelt die Trunk-Registrierung und zeigt den Kontakt auf den SIP-Eingang.
+
+easybell beantwortet REGISTER nur mit vorab gesendeter Authentifizierung
+zuverlaessig; drachtio bekommt dort nur 408. Dieser kleine Daemon registriert
+sich selbst (Contact = <ip>:5060, also drachtio) und erneuert alle ~100 s.
+"""
+import asyncio
+import os
+import signal
+import sys
+
+sys.path.insert(0, "/opt/voice-ai-stack/sip-to-ai")
+
+from app.sip_async.trunk import TrunkClient, TrunkConfig  # noqa: E402
+
+
+async def main() -> None:
+    cfg = TrunkConfig(
+        domain=os.getenv("TRUNK_DOMAIN", "voip.easybell.de"),
+        user=os.getenv("TRUNK_USER", ""),
+        password=os.getenv("TRUNK_PASS", ""),
+        caller_id=os.getenv("TRUNK_CLI", ""),
+        local_ip=os.getenv("PUBLIC_IP", "212.87.214.9"),
+        local_port=int(os.getenv("REGISTRAR_PORT", "5072")),
+    )
+    cfg.contact_port = int(os.getenv("CONTACT_PORT", "5060"))
+
+    client = TrunkClient(cfg)
+    await client.open()
+
+    stop = asyncio.Event()
+    loop = asyncio.get_running_loop()
+    for sig in (signal.SIGINT, signal.SIGTERM):
+        loop.add_signal_handler(sig, stop.set)
+
+    while not stop.is_set():
+        ok = await client.register()
+        print(f"REGISTER {'OK' if ok else 'FEHLER'}", flush=True)
+        try:
+            await asyncio.wait_for(stop.wait(), timeout=100 if ok else 60)
+        except asyncio.TimeoutError:
+            pass
+
+    client.close()
+
+
+asyncio.run(main())
