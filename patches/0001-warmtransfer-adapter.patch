+"""Easybell-Outbound-Test: REGISTER, dann INVITE mit mehreren Nummernformaten."""
+import asyncio
+import os
+
+from app.sip_async.trunk import TrunkClient, TrunkConfig, build_sdp
+
+CFG = TrunkConfig(
+    domain=os.getenv("TRUNK_DOMAIN", "voip.easybell.de"),
+    user=os.getenv("TRUNK_USER", "K4071003T3"),
+    password=os.getenv("TRUNK_PASS", ""),
+    caller_id=os.getenv("TRUNK_CLI", "4942143818790"),
+    local_port=int(os.getenv("TRUNK_LOCAL_PORT", "5070")),
+)
+TARGETS = ["004915236448398", "015236448398", "+4915236448398"]
+
+
+async def main():
+    c = TrunkClient(CFG)
+    await c.open()
+    ok = await c.register()
+    print("REGISTER:", "OK" if ok else "FEHLER")
+    if not ok:
+        return
+    for t in TARGETS:
+        res = await c.invite(t, build_sdp(CFG.local_ip, 40100))
+        print(f"{t} -> {res.get('status')} {res.get('reason', '')}".strip())
+        if res.get("status") == 200:
+            await c.bye(res)
+            print("  (aufgelegt)")
+            break
+        if res.get("status") in (180, 183):
+            print("  (klingelt)")
+            break
+    c.close()
+
+
+asyncio.run(main())
